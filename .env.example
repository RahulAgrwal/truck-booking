# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# In GCP every one of these comes from Secret Manager (TechnicalDocument.md §9.3).

# ---- Database (Neon Postgres 17, database: trucking_go) ----
# Pooled connection — used at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/trucking_go?sslmode=require"
# Direct/unpooled connection — used by `prisma migrate`. Same host without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/trucking_go?sslmode=require"

# ---- Firebase client (inlined into the browser bundle at build time — public by design) ----
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ---- Firebase Admin (server only — NEVER prefix these with NEXT_PUBLIC_) ----
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
# PEM private key. Real newlines, or "\n" escapes — adminApp.ts accepts both.
FIREBASE_ADMIN_PRIVATE_KEY=""

# ---- Google Maps ----
# CLIENT key — Places Autocomplete. Ships in the browser bundle, so it MUST be locked
# down in Cloud Console by HTTP referrer + API restriction (Places API only).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# SERVER key — Distance Matrix. Never sent to the browser. Restrict by API (Distance
# Matrix only) and, if possible, by IP. NEVER give this one the NEXT_PUBLIC_ prefix.
GOOGLE_MAPS_SERVER_API_KEY=""

# ---- Cron ----
# Bearer token Cloud Scheduler presents to /api/cron. Generate: openssl rand -hex 32
CRON_SECRET=""

# ---- Local development only ----
# "true" mocks a signed-in session so the app runs with no Firebase credentials.
# Enforced at RUNTIME by src/lib/session.ts, which refuses to mock a session when
# NODE_ENV=production. next.config.ts only warns (TechnicalDocument.md §4.4).
DEV_AUTH_BYPASS="false"
# Which role the mock session assumes: SHIPPER | CARRIER
DEV_BYPASS_ROLE="SHIPPER"
