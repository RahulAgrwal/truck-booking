// TruckingGO data model.
// Models and fields are verbatim from TruckingGO_Master_PRD.md §3.
// The only additions are the indexes required by the app's list queries
// (TechnicalDocument.md §3.1, decision D2) — additive, no semantic change.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: connection URLs live in prisma.config.ts, not here.
// The runtime client connects through the pg driver adapter (src/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

enum Role {
  SHIPPER
  CARRIER
}

enum AuctionStatus {
  ACTIVE
  CLOSED_EXPIRED
  COMPLETED_ASSIGNED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  firebaseUid  String   @unique
  email        String   @unique
  name         String
  profileImage String?
  role         Role? // Nullable until onboarding completes
  createdAt    DateTime @default(now())

  // Contact details, collected at onboarding step 2 (docs/feature-contact-ratings.md §4).
  // Every one of these is a SENSITIVE column: they are selected only inside
  // src/lib/contact.ts, which gates them behind the "we did a deal" rule, and
  // inside the owner's own profile read. Nowhere else — that is the enforcement.
  // Nullable because every existing row predates the feature.
  phone       String? // 10 bare digits, normalised, no +91 prefix stored
  address     String?
  companyName String? // SHIPPER only
  truckNumber String? // CARRIER only — stored normalised, "MH12AB1234"
  truckType   String? // CARRIER only

  // null = onboarding step 2 not done. A timestamp rather than a boolean so we
  // can tell a pre-feature user from one who filled the form today.
  detailsCompletedAt DateTime?

  // Exact rating aggregate: avg = ratingSum / ratingCount, and integers cannot
  // drift. Both are incremented in the same transaction that inserts the
  // Review, so the aggregate and the rows can never disagree. A cached Float
  // average would be a second source of truth for one fact.
  ratingSum   Int @default(0)
  ratingCount Int @default(0)

  auctions        Auction[] @relation("ShipperAuctions")
  bids            Bid[]     @relation("CarrierBids")
  reviewsWritten  Review[]  @relation("ReviewsWritten")
  reviewsReceived Review[]  @relation("ReviewsReceived")
}

model Auction {
  id              String        @id @default(uuid())
  shipperId       String
  pickupLocation  String
  dropoffLocation String
  materialDetails String
  weightKg        Float
  status          AuctionStatus @default(ACTIVE)
  endTime         DateTime
  createdAt       DateTime      @default(now())

  // Google Maps route data (TechnicalDocument.md §10).
  // Coordinates come from the client-side Places Autocomplete; distance and
  // duration are resolved server-side via the Distance Matrix API at creation.
  // Nullable so auctions created before this feature (and any future non-geocoded
  // path) remain valid.
  pickupLat         Float?
  pickupLng         Float?
  dropoffLat        Float?
  dropoffLng        Float?
  distanceKm        Float?
  estimatedTimeMins Int?

  shipper User     @relation("ShipperAuctions", fields: [shipperId], references: [id])
  bids    Bid[]
  reviews Review[]

  // Carrier feed (status + endTime) and the cron expiry sweep.
  @@index([status, endTime])
  // Shipper dashboard and history.
  @@index([shipperId, createdAt])
}

model Bid {
  id        String    @id @default(uuid())
  auctionId String
  carrierId String
  amount    Float
  status    BidStatus @default(PENDING)
  createdAt DateTime  @default(now())

  auction Auction @relation(fields: [auctionId], references: [id])
  carrier User    @relation("CarrierBids", fields: [carrierId], references: [id])

  // Bid list ordered lowest-first, and the "Best Price" lookup.
  @@index([auctionId, amount])
  // Carrier's "My Bids" screen.
  @@index([carrierId, createdAt])
}

/// One party rating the other after a completed job
/// (docs/feature-contact-ratings.md §4). Ratings are PUBLIC reputation, not
/// contact details — visible to anyone looking at a bid, and deliberately not
/// gated by the Rule 1 visibility check.
model Review {
  id        String   @id @default(uuid())
  auctionId String
  authorId  String
  subjectId String
  stars     Int // 1–5, validated by SubmitReviewSchema and by submitReview
  comment   String?
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id])
  author  User    @relation("ReviewsWritten", fields: [authorId], references: [id])
  subject User    @relation("ReviewsReceived", fields: [subjectId], references: [id])

  // The double-submit guard, and the reason submitReview needs no read-then-
  // write. Same reasoning as acceptBid's status-guarded updateMany
  // (TechnicalDocument §5.4): a constraint is atomic, a read is not. Two taps
  // on Submit race; the loser gets P2002 and a friendly message.
  @@unique([auctionId, authorId])
  // "Reviews received", newest first — the profile and contact-card read.
  @@index([subjectId, createdAt])
}
